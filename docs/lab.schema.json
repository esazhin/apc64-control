{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apc64-host.local/lab.schema.json",
  "title": "APC64 Lab generated layout",
  "description": "One layout file in layouts/ (YAML) with a 'lab:' section. Read docs/lab-guide.md for worked examples; validate with 'apc64 lab validate <file>'. The host keys are as in layout.schema.json; 'routing: custom:' overrides the lab's default note target.",
  "type": "object",
  "required": [
    "name",
    "lab"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name (the OLED shows 14 characters)."
    },
    "lab": {
      "$ref": "#/$defs/lab"
    },
    "device": {
      "$ref": "layout.schema.json#/properties/device"
    },
    "devices": {
      "$ref": "layout.schema.json#/properties/devices"
    },
    "pages": {
      "$ref": "layout.schema.json#/properties/pages"
    },
    "banks": {
      "$ref": "layout.schema.json#/properties/banks"
    },
    "routing": {
      "$ref": "layout.schema.json#/properties/routing"
    }
  },
  "$defs": {
    "lab": {
      "type": "object",
      "required": [
        "generator"
      ],
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "string",
          "enum": [
            "tonnetz",
            "isomorphic",
            "guitar",
            "modes"
          ],
          "description": "Required: which generator fills the 64 pads."
        },
        "scheme": {
          "type": "string",
          "enum": [
            "fifths",
            "root-highlight",
            "scale"
          ],
          "default": "fifths",
          "description": "The colour scheme (any scheme works with any generator)."
        },
        "colours": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Ga-g](♯|#|♭|b|𝄪|𝄫)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/colour"
          },
          "description": "Rest colours by pitch class, over the scheme's: C: [255, 255, 255]."
        },
        "strips": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(strips? )?[1-8](-[1-8])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/strip"
          },
          "description": "Optional (§2.7 q6): strips 1-8 by number or range. Without it the unit's strips are written back exactly as read."
        },
        "base": {
          "description": "A generator parameter (see the tonnetz branch)."
        },
        "channel": {
          "description": "A generator parameter (see the tonnetz branch)."
        },
        "column": {
          "description": "A generator parameter (see the isomorphic branch)."
        },
        "row": {
          "description": "A generator parameter (see the isomorphic branch)."
        },
        "tuning": {
          "description": "A generator parameter (see the guitar branch)."
        },
        "frets": {
          "description": "A generator parameter (see the guitar branch)."
        },
        "fret_marks": {
          "description": "A generator parameter (see the guitar branch)."
        },
        "scale": {
          "description": "A colour scheme parameter (see the scale scheme's branch)."
        },
        "root": {
          "description": "A colour scheme parameter (see the scale scheme's branch)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "generator": {
                "const": "tonnetz"
              }
            },
            "required": [
              "generator"
            ]
          },
          "then": {
            "properties": {
              "base": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  {
                    "type": "string",
                    "pattern": "^[A-Ga-g][#b]?-?\\d+$"
                  }
                ],
                "default": 48,
                "description": "note on pad r1c1 (C3 = 60): a note number 0–127 or a note name such as C2 (48) or F#3 (66)."
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16,
                "default": 1,
                "description": "MIDI channel the unit sends the pads on (q8) (1–16)."
              }
            },
            "propertyNames": {
              "enum": [
                "generator",
                "scheme",
                "colours",
                "strips",
                "base",
                "channel",
                "scale",
                "root"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "isomorphic"
              }
            },
            "required": [
              "generator"
            ]
          },
          "then": {
            "properties": {
              "base": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  {
                    "type": "string",
                    "pattern": "^[A-Ga-g][#b]?-?\\d+$"
                  }
                ],
                "default": 36,
                "description": "note on pad r1c1 (C3 = 60): a note number 0–127 or a note name such as C2 (48) or F#3 (66)."
              },
              "column": {
                "type": "integer",
                "minimum": -12,
                "maximum": 12,
                "default": 1,
                "description": "semitones per column to the right (-12–12)."
              },
              "row": {
                "type": "integer",
                "minimum": -12,
                "maximum": 12,
                "default": 5,
                "description": "semitones per row upwards (-12–12)."
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16,
                "default": 1,
                "description": "MIDI channel the unit sends the pads on (q8) (1–16)."
              }
            },
            "propertyNames": {
              "enum": [
                "generator",
                "scheme",
                "colours",
                "strips",
                "base",
                "column",
                "row",
                "channel",
                "scale",
                "root"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "guitar"
              }
            },
            "required": [
              "generator"
            ]
          },
          "then": {
            "properties": {
              "tuning": {
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "e-standard",
                      "drop-d",
                      "eb-standard",
                      "d-standard",
                      "drop-c",
                      "dadgad",
                      "open-g",
                      "open-d",
                      "b-standard-7",
                      "drop-a-7",
                      "fs-standard-8",
                      "drop-e-8",
                      "bass-4",
                      "bass-5"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 127
                        },
                        {
                          "type": "string",
                          "pattern": "^[A-Ga-g][#b]?-?\\d+$"
                        }
                      ]
                    },
                    "minItems": 4,
                    "maxItems": 8
                  }
                ],
                "default": "e-standard",
                "description": "a preset, or the open strings low to high (4–8 notes, C3 = 60: the low E is E1, 40): one of the names listed, or a list of 4–8 notes (numbers 0–127 or names such as E1 (40), C3 = 60)."
              },
              "frets": {
                "type": "integer",
                "minimum": 12,
                "maximum": 36,
                "default": 24,
                "description": "the neck's length in frets (12–36)."
              },
              "fret_marks": {
                "type": "string",
                "enum": [
                  "on",
                  "off"
                ],
                "default": "on",
                "description": "the inlay frets marked on the pads (on or off): one of the names listed (any case; spaces for '-' are accepted too)."
              }
            },
            "propertyNames": {
              "enum": [
                "generator",
                "scheme",
                "colours",
                "strips",
                "tuning",
                "frets",
                "fret_marks",
                "scale",
                "root"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "modes"
              }
            },
            "required": [
              "generator"
            ]
          },
          "then": {
            "properties": {
              "base": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 115
                  },
                  {
                    "type": "string",
                    "pattern": "^[A-Ga-g][#b]?-?\\d+$"
                  }
                ],
                "default": 48,
                "description": "the root: the note on pad r1c1 and every row's first pad: a note number 0–115 or a note name such as C2 (48) or F#3 (66)."
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16,
                "default": 1,
                "description": "MIDI channel the unit sends the pads on (q8) (1–16)."
              }
            },
            "propertyNames": {
              "enum": [
                "generator",
                "scheme",
                "colours",
                "strips",
                "base",
                "channel",
                "scale",
                "root"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "scale"
              }
            },
            "required": [
              "scheme"
            ]
          },
          "then": {
            "properties": {
              "scale": {
                "type": "string",
                "enum": [
                  "chromatic",
                  "major",
                  "melodic-minor",
                  "harmonic-minor",
                  "major-pentatonic",
                  "minor-pentatonic",
                  "dorian",
                  "phrygian",
                  "lydian",
                  "mixolydian",
                  "aeolian",
                  "locrian",
                  "blues",
                  "whole-tone",
                  "flamenco",
                  "hungarian-minor",
                  "hungarian-major",
                  "harmonic-major",
                  "double-harmonic",
                  "neapolitan-major",
                  "neapolitan-minor",
                  "dorian-b2",
                  "lydian-augmented",
                  "lydian-dominant",
                  "mixolydian-b6",
                  "locrian-natural2",
                  "altered",
                  "phrygian-dominant",
                  "octatonic-half-whole",
                  "octatonic-whole-half",
                  "bebop-dominant",
                  "bebop-major",
                  "hirajoshi",
                  "in",
                  "iwato",
                  "prometheus",
                  "enigmatic"
                ],
                "default": "major",
                "description": "the scale lit (the harmony core's library): one of the names listed (any case; spaces for '-' are accepted too)."
              },
              "root": {
                "type": "string",
                "pattern": "^[A-Ga-g](♯|#|♭|b|𝄪|𝄫)*$",
                "description": "the scale's root, a note name without octave (default: the layout's root): a note name without octave such as D, F# or B♭."
              }
            }
          }
        }
      ],
      "description": "A generated layout. Its encoder shifts the window one step of the interval (right +1, left -1) and Tempo cycles octave → fifth → third, or the generator's own steps (the guitar: Fret and Page); Shift + encoder still browses layouts. Do not bind encoder or tempo on a page of a lab layout."
    },
    "colour": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "[red, green, blue], each 0–255."
        },
        {
          "type": "string",
          "pattern": "^#?[0-9A-Fa-f]{6}$",
          "description": "#RRGGBB."
        },
        {
          "type": "string",
          "enum": [
            "black",
            "blue",
            "cyan",
            "green",
            "magenta",
            "off",
            "orange",
            "pink",
            "purple",
            "red",
            "white",
            "yellow"
          ],
          "description": "A colour name."
        }
      ]
    },
    "strip": {
      "type": "object",
      "required": [
        "cc"
      ],
      "additionalProperties": false,
      "properties": {
        "cc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "The controller (over a range 1-8 it rises by one per strip)."
        },
        "lsb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "With lsb the strip sends 14-bit MSB/LSB pairs; it rises by one per strip too."
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        },
        "ch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Same as channel."
        },
        "bar": {
          "$ref": "#/$defs/colour",
          "description": "Bar colour (default red)."
        },
        "indicator": {
          "$ref": "#/$defs/colour",
          "description": "Indicator colour (default white)."
        },
        "bipolar": {
          "type": "boolean",
          "default": false,
          "description": "Bipolar bar display."
        },
        "outputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "default": 7,
          "description": "Output bitmask: 7 = all outputs (factory), 0 = silent; the single bits are [TBD]."
        }
      }
    }
  }
}
