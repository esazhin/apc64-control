    ],
    "stripControls": [
      "strip 1",
      "strip 2",
      "strip 3",
      "strip 4",
      "strip 5",
      "strip 6",
      "strip 7",
      "strip 8"
    ],
    "rangeForms": [
      "pads r1c1-r2c8 (reading order from the bottom-left)",
      "tracks 1-8",
      "trackctls 1-8",
      "strips 1-8"
    ],
    "messages": [
      "cc",
      "cc14",
      "none",
      "note",
      "notes",
      "pitchbend",
      "program"
    ],
    "options": [
      "toggle",
      "momentary",
      "colour",
      "color",
      "velocity",
      "vel",
      "label",
      "feedback",
      "off",
      "touch",
      "bar",
      "bipolar",
      "colours",
      "colors"
    ],
    "colours": {
      "off": 0,
      "dimwhite": 1,
      "grey": 2,
      "white": 3,
      "red": 5,
      "orange": 9,
      "yellow": 13,
      "lime": 17,
      "green": 21,
      "mint": 29,
      "teal": 33,
      "cyan": 37,
      "blue": 45,
      "purple": 49,
      "magenta": 53,
      "pink": 57,
      "black": 0,
      "dim": 1,
      "gray": 2,
      "violet": 49
    },
    "aftertouch": [
      "drop",
      "pass",
      "pressure"
    ],
    "noteNames": "C3 = 60, so C1 = 36 and C-2 = 0 (Ableton/Akai/MPC convention)",
    "channels": "1-16",
    "limits": {
      "pages": 8,
      "banks": 6
    }
  }
}
